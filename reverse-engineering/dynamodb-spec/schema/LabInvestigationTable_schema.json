{
  "tables": [
    {
      "table_config": {
        "table_name": "LabInvestigationTable",
        "partition_key": "PK",
        "sort_key": "SK"
      },
      "gsi_list": [
        { "name": "GSI1", "partition_key": "GSI1PK", "sort_key": "GSI1SK", "projection": "ALL" }
      ],
      "entities": {
        "InvestigationOrder": {
          "entity_type": "ORDER",
          "pk_template": "ENC#{encounterNumber}",
          "sk_template": "ORDER#{orderCode}",
          "fields": [
            { "name": "encounterNumber", "type": "string", "required": true },
            { "name": "orderCode", "type": "string", "required": true },
            { "name": "orderName", "type": "string", "required": true },
            { "name": "patientMrn", "type": "string", "required": true },
            { "name": "patientName", "type": "string", "required": false },
            { "name": "status", "type": "string", "required": true },
            { "name": "priority", "type": "string", "required": false },
            { "name": "instructions", "type": "string", "required": false },
            { "name": "orderDate", "type": "string", "required": true },
            { "name": "orderedBy", "type": "object", "required": false },
            { "name": "isProfile", "type": "boolean", "required": false },
            { "name": "documentNumber", "type": "string", "required": false }
          ],
          "access_patterns": [
            { "pattern_id": 1101, "name": "list_orders", "description": "List investigation orders for encounter", "operation": "Query", "range_condition": "begins_with", "consistent_read": false, "parameters": [{ "name": "encounterNumber", "type": "string" }, { "name": "prefix", "type": "string" }], "return_type": "entity_list" },
            { "pattern_id": 1102, "name": "create_order", "description": "Create investigation order", "operation": "PutItem", "parameters": [{ "name": "order", "type": "entity", "entity_type": "InvestigationOrder" }], "return_type": "single_entity" }
          ]
        },
        "LabResult": {
          "entity_type": "RESULT",
          "pk_template": "ENC#{encounterNumber}",
          "sk_template": "RESULT#{resultCode}##{resultDate}",
          "gsi_mappings": [
            { "name": "GSI1", "pk_template": "PAT#{patientMrn}", "sk_template": "DATE#{resultDate}#RESULT#{resultCode}" }
          ],
          "fields": [
            { "name": "encounterNumber", "type": "string", "required": true },
            { "name": "patientMrn", "type": "string", "required": true },
            { "name": "resultCode", "type": "string", "required": true },
            { "name": "resultName", "type": "string", "required": true },
            { "name": "displayName", "type": "string", "required": false },
            { "name": "value", "type": "string", "required": false },
            { "name": "resultType", "type": "string", "required": true },
            { "name": "unit", "type": "string", "required": false },
            { "name": "referenceRange", "type": "string", "required": false },
            { "name": "abnormalFlag", "type": "string", "required": false },
            { "name": "resultDate", "type": "string", "required": true },
            { "name": "parameters", "type": "array", "required": false, "item_type": "object" },
            { "name": "reports", "type": "array", "required": false, "item_type": "object" }
          ],
          "access_patterns": [
            { "pattern_id": 1103, "name": "list_results", "description": "List lab results for encounter", "operation": "Query", "range_condition": "begins_with", "consistent_read": false, "parameters": [{ "name": "encounterNumber", "type": "string" }, { "name": "prefix", "type": "string" }], "return_type": "entity_list" },
            { "pattern_id": 1104, "name": "store_result", "description": "Store lab result", "operation": "PutItem", "parameters": [{ "name": "result", "type": "entity", "entity_type": "LabResult" }], "return_type": "single_entity" },
            { "pattern_id": 1105, "name": "patient_results", "description": "Cross-encounter results for patient", "operation": "Query", "index_name": "GSI1", "consistent_read": false, "parameters": [{ "name": "patientMrn", "type": "string" }], "return_type": "entity_list" },
            { "pattern_id": 1106, "name": "patient_results_date_range", "description": "Patient results in date range", "operation": "Query", "index_name": "GSI1", "range_condition": "between", "consistent_read": false, "parameters": [{ "name": "patientMrn", "type": "string" }, { "name": "fromDate", "type": "string" }, { "name": "toDate", "type": "string" }], "return_type": "entity_list" }
          ]
        },
        "RadiologyResult": {
          "entity_type": "RAD",
          "pk_template": "ENC#{encounterNumber}",
          "sk_template": "RAD#{studyUID}",
          "fields": [
            { "name": "encounterNumber", "type": "string", "required": true },
            { "name": "studyUID", "type": "string", "required": true },
            { "name": "modality", "type": "string", "required": true },
            { "name": "studyName", "type": "string", "required": false },
            { "name": "studyDate", "type": "string", "required": false },
            { "name": "orderStatus", "type": "string", "required": false },
            { "name": "images", "type": "array", "required": false, "item_type": "object" },
            { "name": "aiMediaFindings", "type": "array", "required": false, "item_type": "object" },
            { "name": "reportType", "type": "string", "required": false },
            { "name": "reportS3Key", "type": "string", "required": false }
          ],
          "access_patterns": [
            { "pattern_id": 1107, "name": "get_radiology", "description": "Get radiology result", "operation": "GetItem", "consistent_read": true, "parameters": [{ "name": "encounterNumber", "type": "string" }, { "name": "studyUID", "type": "string" }], "return_type": "single_entity" },
            { "pattern_id": 1108, "name": "list_radiology", "description": "List radiology results for encounter", "operation": "Query", "range_condition": "begins_with", "consistent_read": false, "parameters": [{ "name": "encounterNumber", "type": "string" }, { "name": "prefix", "type": "string" }], "return_type": "entity_list" }
          ]
        }
      }
    }
  ]
}
