{
  "tables": [
    {
      "table_config": {
        "table_name": "EncounterTable",
        "partition_key": "PK",
        "sort_key": "SK"
      },
      "gsi_list": [
        { "name": "GSI1", "partition_key": "GSI1PK", "sort_key": "GSI1SK", "projection": "ALL" },
        { "name": "GSI2", "partition_key": "GSI2PK", "sort_key": "GSI2SK", "projection": "ALL" },
        { "name": "GSI3", "partition_key": "GSI3PK", "sort_key": "GSI3SK", "projection": "ALL" }
      ],
      "entities": {
        "EncounterMetadata": {
          "entity_type": "METADATA",
          "pk_template": "ENC#{encounterNumber}",
          "sk_template": "METADATA",
          "gsi_mappings": [
            { "name": "GSI1", "pk_template": "PAT#{patientId}", "sk_template": "DATE#{admissionDate}" },
            { "name": "GSI2", "pk_template": "DOC#{consultantLogin}#UNIT#{unitCode}", "sk_template": "DATE#{admissionDate}" },
            { "name": "GSI3", "pk_template": "UNIT#{unitCode}#STATUS#{status}", "sk_template": "WARD#{wardSort}#TIME#{lastMsgTime}" }
          ],
          "fields": [
            { "name": "encounterNumber", "type": "string", "required": true },
            { "name": "patientId", "type": "string", "required": true },
            { "name": "mrn", "type": "string", "required": true },
            { "name": "patientName", "type": "string", "required": true },
            { "name": "status", "type": "string", "required": true },
            { "name": "consultantLogin", "type": "string", "required": true },
            { "name": "consultantName", "type": "string", "required": true },
            { "name": "unitCode", "type": "string", "required": true },
            { "name": "wardSort", "type": "integer", "required": true },
            { "name": "admissionDate", "type": "string", "required": true },
            { "name": "lastMsgTime", "type": "string", "required": false },
            { "name": "location", "type": "string", "required": false },
            { "name": "visitType", "type": "string", "required": false },
            { "name": "pinFlag", "type": "integer", "required": false },
            { "name": "unreadMsgCount", "type": "integer", "required": false },
            { "name": "riskScore", "type": "string", "required": false },
            { "name": "comorbidities", "type": "string", "required": false },
            { "name": "mlc", "type": "boolean", "required": false },
            { "name": "dischargeIntimation", "type": "string", "required": false },
            { "name": "ipActivityAction", "type": "string", "required": false }
          ],
          "access_patterns": [
            { "pattern_id": 20, "name": "get_encounter", "description": "Get encounter by number", "operation": "GetItem", "consistent_read": true, "parameters": [{ "name": "encounterNumber", "type": "string" }], "return_type": "single_entity" },
            { "pattern_id": 21, "name": "encounters_by_patient", "description": "Patient encounters", "operation": "Query", "index_name": "GSI1", "consistent_read": false, "parameters": [{ "name": "patientId", "type": "string" }], "return_type": "entity_list" },
            { "pattern_id": 22, "name": "encounters_by_doctor", "description": "Doctor patient list", "operation": "Query", "index_name": "GSI2", "consistent_read": false, "parameters": [{ "name": "gsi2pk", "type": "string" }], "return_type": "entity_list" },
            { "pattern_id": 23, "name": "active_by_unit", "description": "Active encounters by unit", "operation": "Query", "index_name": "GSI3", "consistent_read": false, "parameters": [{ "name": "gsi3pk", "type": "string" }], "return_type": "entity_list" },
            { "pattern_id": 24, "name": "update_status", "description": "Update encounter status", "operation": "UpdateItem", "parameters": [{ "name": "encounterNumber", "type": "string" }, { "name": "status", "type": "string" }], "return_type": "single_entity" }
          ]
        },
        "CareTeamMember": {
          "entity_type": "MEMBER",
          "pk_template": "ENC#{encounterNumber}",
          "sk_template": "MEMBER#{userId}",
          "fields": [
            { "name": "encounterNumber", "type": "string", "required": true },
            { "name": "userId", "type": "string", "required": true },
            { "name": "userLogin", "type": "string", "required": true },
            { "name": "userName", "type": "string", "required": true },
            { "name": "category", "type": "string", "required": true },
            { "name": "isAdmin", "type": "boolean", "required": false },
            { "name": "active", "type": "boolean", "required": true }
          ],
          "access_patterns": [
            { "pattern_id": 25, "name": "list_team", "description": "Care team members", "operation": "Query", "range_condition": "begins_with", "consistent_read": false, "parameters": [{ "name": "encounterNumber", "type": "string" }, { "name": "prefix", "type": "string" }], "return_type": "entity_list" },
            { "pattern_id": 26, "name": "add_member", "description": "Add team member", "operation": "PutItem", "parameters": [{ "name": "member", "type": "entity", "entity_type": "CareTeamMember" }], "return_type": "single_entity" }
          ]
        },
        "Appointment": {
          "entity_type": "APT",
          "pk_template": "APT#{appointmentNumber}",
          "sk_template": "METADATA",
          "fields": [
            { "name": "appointmentNumber", "type": "string", "required": true },
            { "name": "patientMrn", "type": "string", "required": true },
            { "name": "patientName", "type": "string", "required": true },
            { "name": "doctorLogin", "type": "string", "required": true },
            { "name": "consultationStatus", "type": "string", "required": true },
            { "name": "appointmentDate", "type": "string", "required": true },
            { "name": "appointmentType", "type": "string", "required": false }
          ],
          "access_patterns": [
            { "pattern_id": 27, "name": "get_appointment", "description": "Get appointment", "operation": "GetItem", "consistent_read": true, "parameters": [{ "name": "appointmentNumber", "type": "string" }], "return_type": "single_entity" },
            { "pattern_id": 28, "name": "create_appointment", "description": "Book appointment", "operation": "PutItem", "parameters": [{ "name": "apt", "type": "entity", "entity_type": "Appointment" }], "return_type": "single_entity" }
          ]
        }
      }
    }
  ]
}
