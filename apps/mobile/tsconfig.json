{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "../../src/*"
      ],
      "@app/*": [
        "../../src/app/*"
      ],
      "@shared/*": [
        "../../src/shared/*"
      ],
      "@entities/*": [
        "../../src/entities/*"
      ],
      "@features/*": [
        "../../src/features/*"
      ],
      "@mobile/*": [
        "./src/*"
      ],
      "@core/*": [
        "../../packages/core/src/*"
      ],
      "expo-router": [
        "./node_modules/expo-router"
      ],
      "expo-linear-gradient": [
        "./node_modules/expo-linear-gradient"
      ],
      "lucide-react-native": [
        "./node_modules/lucide-react-native"
      ],
      "react-native-safe-area-context": [
        "./node_modules/react-native-safe-area-context"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}
