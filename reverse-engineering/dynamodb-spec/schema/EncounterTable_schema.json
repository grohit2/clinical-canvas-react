{
  "tables": [
    {
      "table_config": {
        "table_name": "EncounterTable",
        "partition_key": "PK",
        "sort_key": "SK"
      },
      "gsi_list": [
        {
          "name": "GSI1",
          "partition_key": "GSI1PK",
          "sort_key": "GSI1SK",
          "projection": "ALL"
        },
        {
          "name": "GSI2",
          "partition_key": "GSI2PK",
          "sort_key": "GSI2SK",
          "projection": "ALL"
        },
        {
          "name": "GSI3",
          "partition_key": "GSI3PK",
          "sort_key": "GSI3SK",
          "projection": "ALL"
        }
      ],
      "entities": {
        "EncounterMetadata": {
          "entity_type": "METADATA",
          "pk_template": "ENC#{encounterNumber}",
          "sk_template": "METADATA",
          "gsi_mappings": [
            {
              "name": "GSI1",
              "pk_template": "PAT#{patientId}",
              "sk_template": "DATE#{admissionDate}"
            },
            {
              "name": "GSI2",
              "pk_template": "DOC#{consultantLogin}#UNIT#{unitCode}",
              "sk_template": "DATE#{admissionDate}"
            },
            {
              "name": "GSI3",
              "pk_template": "UNIT#{unitCode}#STATUS#{status}",
              "sk_template": "WARD#{wardSort}#TIME#{lastMsgTime}"
            }
          ],
          "fields": [
            { "name": "encounterNumber", "type": "string", "required": true },
            { "name": "patientId", "type": "string", "required": true },
            { "name": "mrn", "type": "string", "required": true },
            { "name": "patientName", "type": "string", "required": true },
            { "name": "gender", "type": "string", "required": true },
            { "name": "dateOfBirth", "type": "string", "required": true },
            { "name": "weight", "type": "string", "required": false },
            { "name": "encounterClass", "type": "string", "required": true },
            { "name": "status", "type": "string", "required": true },
            { "name": "consultantLogin", "type": "string", "required": true },
            { "name": "consultantName", "type": "string", "required": true },
            { "name": "consultantShortName", "type": "string", "required": false },
            { "name": "attendingConsultantLogin", "type": "string", "required": false },
            { "name": "attendingConsultantName", "type": "string", "required": false },
            { "name": "department", "type": "string", "required": true },
            { "name": "departmentCode", "type": "string", "required": false },
            { "name": "unitCode", "type": "string", "required": true },
            { "name": "unitName", "type": "string", "required": false },
            { "name": "hscId", "type": "integer", "required": false },
            { "name": "hscName", "type": "string", "required": false },
            { "name": "location", "type": "string", "required": false },
            { "name": "wardCapability", "type": "string", "required": false },
            { "name": "wardSort", "type": "integer", "required": true },
            { "name": "admissionDate", "type": "string", "required": true },
            { "name": "admissionNumber", "type": "string", "required": false },
            { "name": "admissionReason", "type": "string", "required": false },
            { "name": "admissionCategory", "type": "string", "required": false },
            { "name": "visitType", "type": "string", "required": false },
            { "name": "procedureDate", "type": "string", "required": false },
            { "name": "riskScore", "type": "string", "required": false },
            { "name": "comorbidities", "type": "string", "required": false },
            { "name": "mlc", "type": "boolean", "required": false },
            { "name": "pinFlag", "type": "integer", "required": false },
            { "name": "pinOrder", "type": "integer", "required": false },
            { "name": "unreadMsgCount", "type": "integer", "required": false },
            { "name": "dischargeIntimation", "type": "string", "required": false },
            { "name": "dischargeDate", "type": "string", "required": false },
            { "name": "ipActivityAction", "type": "string", "required": false },
            { "name": "lastMsgTime", "type": "string", "required": false },
            { "name": "lastSyncTime", "type": "string", "required": false },
            { "name": "lastSeenDate", "type": "string", "required": false },
            { "name": "expectedDischargeDate", "type": "string", "required": false },
            { "name": "acsGroupId", "type": "string", "required": false },
            { "name": "acceptingConsultantLogin", "type": "string", "required": false },
            { "name": "acceptingConsultantName", "type": "string", "required": false },
            { "name": "consultantHandoverStatus", "type": "string", "required": false },
            { "name": "supportingConsultants", "type": "array", "required": false, "item_type": "object" }
          ],
          "access_patterns": [
            {
              "pattern_id": 1,
              "name": "get_encounter",
              "description": "Get encounter metadata by encounter number",
              "operation": "GetItem",
              "consistent_read": true,
              "parameters": [
                { "name": "encounterNumber", "type": "string" }
              ],
              "return_type": "single_entity"
            },
            {
              "pattern_id": 2,
              "name": "create_encounter",
              "description": "Create new encounter",
              "operation": "PutItem",
              "parameters": [
                { "name": "encounter", "type": "entity", "entity_type": "EncounterMetadata" }
              ],
              "return_type": "single_entity"
            },
            {
              "pattern_id": 3,
              "name": "update_encounter_status",
              "description": "Update encounter status (discharge, MFD, etc.)",
              "operation": "UpdateItem",
              "parameters": [
                { "name": "encounterNumber", "type": "string" },
                { "name": "status", "type": "string" },
                { "name": "ipActivityAction", "type": "string" }
              ],
              "return_type": "single_entity"
            },
            {
              "pattern_id": 4,
              "name": "encounters_by_patient",
              "description": "List encounters for a patient sorted by admission date",
              "operation": "Query",
              "index_name": "GSI1",
              "consistent_read": false,
              "parameters": [
                { "name": "patientId", "type": "string" }
              ],
              "return_type": "entity_list"
            },
            {
              "pattern_id": 5,
              "name": "encounters_by_doctor",
              "description": "List encounters for a doctor in a unit",
              "operation": "Query",
              "index_name": "GSI2",
              "consistent_read": false,
              "parameters": [
                { "name": "consultantLogin", "type": "string" },
                { "name": "unitCode", "type": "string" }
              ],
              "return_type": "entity_list"
            },
            {
              "pattern_id": 6,
              "name": "active_encounters_by_unit",
              "description": "List active encounters for a unit sorted by ward and last message time",
              "operation": "Query",
              "index_name": "GSI3",
              "consistent_read": false,
              "parameters": [
                { "name": "unitCode", "type": "string" },
                { "name": "status", "type": "string" }
              ],
              "return_type": "entity_list"
            },
            {
              "pattern_id": 7,
              "name": "update_unread_count",
              "description": "Increment or decrement unread message count",
              "operation": "UpdateItem",
              "parameters": [
                { "name": "encounterNumber", "type": "string" },
                { "name": "unreadMsgCount", "type": "integer" }
              ],
              "return_type": "single_entity"
            }
          ]
        },
        "RiskScore": {
          "entity_type": "RISK",
          "pk_template": "ENC#{encounterNumber}",
          "sk_template": "RISK#{refreshDatetime}",
          "fields": [
            { "name": "encounterNumber", "type": "string", "required": true },
            { "name": "refreshDatetime", "type": "string", "required": true },
            { "name": "riskScorePercentage", "type": "decimal", "required": true },
            { "name": "riskScoreValue", "type": "decimal", "required": false },
            { "name": "dataJson", "type": "array", "required": false, "item_type": "object" },
            { "name": "aiPrediction", "type": "object", "required": false },
            { "name": "losDay", "type": "integer", "required": false },
            { "name": "summary", "type": "string", "required": false },
            { "name": "observations", "type": "string", "required": false }
          ],
          "access_patterns": [
            {
              "pattern_id": 8,
              "name": "store_risk_score",
              "description": "Store a new risk score calculation",
              "operation": "PutItem",
              "parameters": [
                { "name": "riskScore", "type": "entity", "entity_type": "RiskScore" }
              ],
              "return_type": "single_entity"
            },
            {
              "pattern_id": 9,
              "name": "get_risk_score_trend",
              "description": "Get risk score history for encounter",
              "operation": "Query",
              "range_condition": "begins_with",
              "consistent_read": false,
              "parameters": [
                { "name": "encounterNumber", "type": "string" },
                { "name": "prefix", "type": "string" }
              ],
              "return_type": "entity_list"
            }
          ]
        },
        "Comorbidity": {
          "entity_type": "COMORBIDITY",
          "pk_template": "ENC#{encounterNumber}",
          "sk_template": "COMORBIDITY#{code}",
          "fields": [
            { "name": "encounterNumber", "type": "string", "required": true },
            { "name": "code", "type": "string", "required": true },
            { "name": "name", "type": "string", "required": true },
            { "name": "category", "type": "string", "required": false },
            { "name": "shortName", "type": "string", "required": true },
            { "name": "active", "type": "boolean", "required": true },
            { "name": "createdBy", "type": "object", "required": false },
            { "name": "createdOn", "type": "string", "required": false }
          ],
          "access_patterns": [
            {
              "pattern_id": 10,
              "name": "add_comorbidity",
              "description": "Add a comorbidity record",
              "operation": "PutItem",
              "parameters": [
                { "name": "comorbidity", "type": "entity", "entity_type": "Comorbidity" }
              ],
              "return_type": "single_entity"
            },
            {
              "pattern_id": 11,
              "name": "toggle_comorbidity",
              "description": "Toggle comorbidity active status",
              "operation": "UpdateItem",
              "parameters": [
                { "name": "encounterNumber", "type": "string" },
                { "name": "code", "type": "string" },
                { "name": "active", "type": "boolean" }
              ],
              "return_type": "single_entity"
            },
            {
              "pattern_id": 12,
              "name": "list_comorbidities",
              "description": "List all comorbidities for an encounter",
              "operation": "Query",
              "range_condition": "begins_with",
              "consistent_read": false,
              "parameters": [
                { "name": "encounterNumber", "type": "string" },
                { "name": "prefix", "type": "string" }
              ],
              "return_type": "entity_list"
            }
          ]
        },
        "Admission": {
          "entity_type": "ADMISSION",
          "pk_template": "ENC#{encounterNumber}",
          "sk_template": "ADMISSION",
          "fields": [
            { "name": "encounterNumber", "type": "string", "required": true },
            { "name": "admissionNumber", "type": "string", "required": true },
            { "name": "visitType", "type": "string", "required": false },
            { "name": "department", "type": "string", "required": false },
            { "name": "primaryConsultant", "type": "object", "required": false },
            { "name": "supportingConsultants", "type": "array", "required": false, "item_type": "object" },
            { "name": "admissionDate", "type": "string", "required": true },
            { "name": "expectedDischargeDate", "type": "string", "required": false },
            { "name": "ward", "type": "object", "required": false },
            { "name": "bedNumber", "type": "string", "required": false },
            { "name": "reasonForAdmission", "type": "string", "required": false },
            { "name": "triage", "type": "string", "required": false },
            { "name": "medicoLegalCase", "type": "boolean", "required": false },
            { "name": "chargeClass", "type": "string", "required": false }
          ],
          "access_patterns": [
            {
              "pattern_id": 13,
              "name": "get_admission_details",
              "description": "Get detailed admission record",
              "operation": "GetItem",
              "consistent_read": true,
              "parameters": [
                { "name": "encounterNumber", "type": "string" }
              ],
              "return_type": "single_entity"
            },
            {
              "pattern_id": 14,
              "name": "create_admission",
              "description": "Create admission details",
              "operation": "PutItem",
              "parameters": [
                { "name": "admission", "type": "entity", "entity_type": "Admission" }
              ],
              "return_type": "single_entity"
            }
          ]
        },
        "BedTransfer": {
          "entity_type": "TRANSFER",
          "pk_template": "ENC#{encounterNumber}",
          "sk_template": "TRANSFER#{transferTimestamp}",
          "fields": [
            { "name": "encounterNumber", "type": "string", "required": true },
            { "name": "transferTimestamp", "type": "string", "required": true },
            { "name": "fromLocation", "type": "string", "required": true },
            { "name": "toLocation", "type": "string", "required": true },
            { "name": "fromWard", "type": "string", "required": false },
            { "name": "toWard", "type": "string", "required": false },
            { "name": "reason", "type": "string", "required": false },
            { "name": "transferredBy", "type": "object", "required": false }
          ],
          "access_patterns": [
            {
              "pattern_id": 15,
              "name": "record_bed_transfer",
              "description": "Record a bed/ward transfer",
              "operation": "PutItem",
              "parameters": [
                { "name": "transfer", "type": "entity", "entity_type": "BedTransfer" }
              ],
              "return_type": "single_entity"
            }
          ]
        }
      }
    }
  ]
}
