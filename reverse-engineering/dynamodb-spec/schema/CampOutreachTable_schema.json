{
  "tables": [
    {
      "table_config": {
        "table_name": "CampOutreachTable",
        "partition_key": "PK",
        "sort_key": "SK"
      },
      "gsi_list": [
        { "name": "GSI1", "partition_key": "GSI1PK", "sort_key": "GSI1SK", "projection": "ALL" },
        { "name": "GSI2", "partition_key": "GSI2PK", "sort_key": "GSI2SK", "projection": "ALL" }
      ],
      "entities": {
        "CampMetadata": {
          "entity_type": "METADATA",
          "pk_template": "CAMP#{campId}",
          "sk_template": "METADATA",
          "gsi_mappings": [
            { "name": "GSI1", "pk_template": "UNIT#{unitCode}#STATUS#{status}", "sk_template": "DATE#{startDate}" }
          ],
          "fields": [
            { "name": "campId", "type": "string", "required": true },
            { "name": "campName", "type": "string", "required": true },
            { "name": "campCode", "type": "string", "required": false },
            { "name": "status", "type": "string", "required": true },
            { "name": "startDate", "type": "string", "required": true },
            { "name": "endDate", "type": "string", "required": false },
            { "name": "location", "type": "string", "required": false },
            { "name": "address", "type": "object", "required": false },
            { "name": "organizationId", "type": "string", "required": true },
            { "name": "unitCode", "type": "string", "required": true },
            { "name": "totalPatients", "type": "integer", "required": false },
            { "name": "createdBy", "type": "string", "required": true },
            { "name": "createdAt", "type": "string", "required": true }
          ],
          "access_patterns": [
            { "pattern_id": 1001, "name": "get_camp", "description": "Get camp details", "operation": "GetItem", "consistent_read": true, "parameters": [{ "name": "campId", "type": "string" }], "return_type": "single_entity" },
            { "pattern_id": 1002, "name": "camps_by_unit_status", "description": "List camps by unit and status", "operation": "Query", "index_name": "GSI1", "consistent_read": false, "parameters": [{ "name": "gsi1pk", "type": "string" }], "return_type": "entity_list" },
            { "pattern_id": 1003, "name": "update_camp_status", "description": "Update camp status", "operation": "UpdateItem", "parameters": [{ "name": "campId", "type": "string" }, { "name": "status", "type": "string" }], "return_type": "single_entity" }
          ]
        },
        "CampPatient": {
          "entity_type": "PAT",
          "pk_template": "CAMP#{campId}",
          "sk_template": "PAT#{patientId}",
          "gsi_mappings": [
            { "name": "GSI2", "pk_template": "PAT#{patientId}", "sk_template": "CAMP#{campId}" }
          ],
          "fields": [
            { "name": "campId", "type": "string", "required": true },
            { "name": "patientId", "type": "string", "required": true },
            { "name": "uhid", "type": "string", "required": false },
            { "name": "tempId", "type": "string", "required": false },
            { "name": "patientName", "type": "string", "required": true },
            { "name": "mobileNumber", "type": "string", "required": false },
            { "name": "gender", "type": "string", "required": false },
            { "name": "age", "type": "object", "required": false },
            { "name": "registeredAt", "type": "string", "required": true },
            { "name": "registeredBy", "type": "string", "required": true },
            { "name": "registrationStatus", "type": "string", "required": false },
            { "name": "consultationStatus", "type": "string", "required": false }
          ],
          "access_patterns": [
            { "pattern_id": 1004, "name": "register_patient", "description": "Register patient in camp", "operation": "PutItem", "parameters": [{ "name": "campPatient", "type": "entity", "entity_type": "CampPatient" }], "return_type": "single_entity" },
            { "pattern_id": 1005, "name": "list_camp_patients", "description": "List patients in camp", "operation": "Query", "range_condition": "begins_with", "consistent_read": false, "parameters": [{ "name": "campId", "type": "string" }, { "name": "prefix", "type": "string" }], "return_type": "entity_list" },
            { "pattern_id": 1006, "name": "patient_camps", "description": "List camps for a patient (reverse)", "operation": "Query", "index_name": "GSI2", "consistent_read": false, "parameters": [{ "name": "patientId", "type": "string" }], "return_type": "entity_list" }
          ]
        }
      }
    }
  ]
}
