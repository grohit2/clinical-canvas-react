{
  "tables": [
    {
      "table_config": {
        "table_name": "UserStaffTable",
        "partition_key": "PK",
        "sort_key": "SK"
      },
      "gsi_list": [
        {
          "name": "GSI1",
          "partition_key": "GSI1PK",
          "sort_key": "GSI1SK",
          "projection": "ALL"
        },
        {
          "name": "GSI2",
          "partition_key": "GSI2PK",
          "sort_key": "GSI2SK",
          "projection": "ALL"
        },
        {
          "name": "GSI3",
          "partition_key": "GSI3PK",
          "sort_key": "GSI3SK",
          "projection": "KEYS_ONLY"
        }
      ],
      "entities": {
        "UserProfile": {
          "entity_type": "PROFILE",
          "pk_template": "USER#{userId}",
          "sk_template": "PROFILE",
          "gsi_mappings": [
            {
              "name": "GSI1",
              "pk_template": "LOGIN#{login}",
              "sk_template": "USER#{userId}"
            },
            {
              "name": "GSI2",
              "pk_template": "UNIT#{unitCode}",
              "sk_template": "ROLE#{primaryRole}#USER#{userId}"
            },
            {
              "name": "GSI3",
              "pk_template": "ORG#{organizationId}",
              "sk_template": "UNIT#{unitCode}#USER#{userId}"
            }
          ],
          "fields": [
            { "name": "userId", "type": "string", "required": true },
            { "name": "login", "type": "string", "required": true },
            { "name": "displayName", "type": "string", "required": true },
            { "name": "firstName", "type": "string", "required": true },
            { "name": "lastName", "type": "string", "required": false },
            { "name": "email", "type": "string", "required": false },
            { "name": "mobileNumber", "type": "string", "required": false },
            { "name": "primaryRole", "type": "string", "required": true },
            { "name": "roles", "type": "array", "required": true, "item_type": "string" },
            { "name": "department", "type": "string", "required": false },
            { "name": "departmentCode", "type": "string", "required": false },
            { "name": "designation", "type": "string", "required": false },
            { "name": "specialization", "type": "string", "required": false },
            { "name": "qualifications", "type": "string", "required": false },
            { "name": "unitCode", "type": "string", "required": true },
            { "name": "organizationId", "type": "string", "required": true },
            { "name": "isActive", "type": "boolean", "required": true },
            { "name": "photo", "type": "string", "required": false },
            { "name": "employeeNo", "type": "string", "required": false },
            { "name": "passwordExpired", "type": "boolean", "required": false },
            { "name": "accountLocked", "type": "boolean", "required": false },
            { "name": "lastLoginAt", "type": "string", "required": false },
            { "name": "createdAt", "type": "string", "required": true },
            { "name": "updatedAt", "type": "string", "required": false }
          ],
          "access_patterns": [
            {
              "pattern_id": 201,
              "name": "get_user_profile",
              "description": "Get user/staff profile by ID",
              "operation": "GetItem",
              "consistent_read": true,
              "parameters": [
                { "name": "userId", "type": "string" }
              ],
              "return_type": "single_entity"
            },
            {
              "pattern_id": 202,
              "name": "get_user_by_login",
              "description": "Lookup user by login username",
              "operation": "Query",
              "index_name": "GSI1",
              "consistent_read": false,
              "parameters": [
                { "name": "login", "type": "string" }
              ],
              "return_type": "entity_list"
            },
            {
              "pattern_id": 203,
              "name": "list_users_by_unit",
              "description": "List all users in a unit, optionally filtered by role",
              "operation": "Query",
              "index_name": "GSI2",
              "consistent_read": false,
              "parameters": [
                { "name": "unitCode", "type": "string" }
              ],
              "return_type": "entity_list"
            },
            {
              "pattern_id": 204,
              "name": "list_doctors_by_unit",
              "description": "List doctors in a unit (role prefix filter)",
              "operation": "Query",
              "index_name": "GSI2",
              "range_condition": "begins_with",
              "consistent_read": false,
              "parameters": [
                { "name": "unitCode", "type": "string" },
                { "name": "rolePrefix", "type": "string" }
              ],
              "return_type": "entity_list"
            },
            {
              "pattern_id": 205,
              "name": "list_users_by_org",
              "description": "List users by organization",
              "operation": "Query",
              "index_name": "GSI3",
              "consistent_read": false,
              "parameters": [
                { "name": "organizationId", "type": "string" }
              ],
              "return_type": "entity_list"
            },
            {
              "pattern_id": 206,
              "name": "create_user",
              "description": "Create a new user/staff profile",
              "operation": "PutItem",
              "parameters": [
                { "name": "user", "type": "entity", "entity_type": "UserProfile" }
              ],
              "return_type": "single_entity"
            },
            {
              "pattern_id": 207,
              "name": "update_user_status",
              "description": "Activate or deactivate a user",
              "operation": "UpdateItem",
              "parameters": [
                { "name": "userId", "type": "string" },
                { "name": "isActive", "type": "boolean" }
              ],
              "return_type": "single_entity"
            }
          ]
        },
        "UserPreferences": {
          "entity_type": "PREF",
          "pk_template": "USER#{userId}",
          "sk_template": "PREF",
          "fields": [
            { "name": "userId", "type": "string", "required": true },
            { "name": "notificationPreferences", "type": "object", "required": false },
            { "name": "locale", "type": "string", "required": false },
            { "name": "country", "type": "string", "required": false },
            { "name": "lastViewModule", "type": "string", "required": false },
            { "name": "sortPreference", "type": "string", "required": false },
            { "name": "filterPreference", "type": "object", "required": false }
          ],
          "access_patterns": [
            {
              "pattern_id": 208,
              "name": "get_user_preferences",
              "description": "Get user preferences and notification settings",
              "operation": "GetItem",
              "consistent_read": false,
              "parameters": [
                { "name": "userId", "type": "string" }
              ],
              "return_type": "single_entity"
            },
            {
              "pattern_id": 209,
              "name": "update_user_preferences",
              "description": "Update user preferences",
              "operation": "PutItem",
              "parameters": [
                { "name": "prefs", "type": "entity", "entity_type": "UserPreferences" }
              ],
              "return_type": "single_entity"
            }
          ]
        },
        "DoctorSchedule": {
          "entity_type": "SCHEDULE",
          "pk_template": "USER#{userId}",
          "sk_template": "SCHEDULE#{scheduleDate}",
          "fields": [
            { "name": "userId", "type": "string", "required": true },
            { "name": "scheduleDate", "type": "string", "required": true },
            { "name": "consultationSlots", "type": "array", "required": false, "item_type": "object" },
            { "name": "maxAppointments", "type": "integer", "required": false },
            { "name": "isAvailable", "type": "boolean", "required": true },
            { "name": "consultationFee", "type": "decimal", "required": false }
          ],
          "access_patterns": [
            {
              "pattern_id": 210,
              "name": "get_doctor_schedule",
              "description": "Get doctor's schedule for a specific date",
              "operation": "GetItem",
              "consistent_read": false,
              "parameters": [
                { "name": "userId", "type": "string" },
                { "name": "scheduleDate", "type": "string" }
              ],
              "return_type": "single_entity"
            },
            {
              "pattern_id": 211,
              "name": "update_doctor_schedule",
              "description": "Update doctor availability and schedule",
              "operation": "PutItem",
              "parameters": [
                { "name": "schedule", "type": "entity", "entity_type": "DoctorSchedule" }
              ],
              "return_type": "single_entity"
            },
            {
              "pattern_id": 212,
              "name": "list_doctor_schedule_range",
              "description": "Get doctor schedule for a date range",
              "operation": "Query",
              "range_condition": "between",
              "consistent_read": false,
              "parameters": [
                { "name": "userId", "type": "string" },
                { "name": "fromDate", "type": "string" },
                { "name": "toDate", "type": "string" }
              ],
              "return_type": "entity_list"
            }
          ]
        },
        "FcmToken": {
          "entity_type": "FCM",
          "pk_template": "USER#{userId}",
          "sk_template": "FCM#{deviceId}",
          "fields": [
            { "name": "userId", "type": "string", "required": true },
            { "name": "deviceId", "type": "string", "required": true },
            { "name": "fcmToken", "type": "string", "required": true },
            { "name": "platform", "type": "string", "required": true },
            { "name": "appVersion", "type": "string", "required": false },
            { "name": "isActive", "type": "boolean", "required": true },
            { "name": "lastUpdated", "type": "string", "required": true }
          ],
          "access_patterns": [
            {
              "pattern_id": 213,
              "name": "register_fcm_token",
              "description": "Register or update FCM device token",
              "operation": "PutItem",
              "parameters": [
                { "name": "fcm", "type": "entity", "entity_type": "FcmToken" }
              ],
              "return_type": "single_entity"
            },
            {
              "pattern_id": 214,
              "name": "deactivate_fcm_token",
              "description": "Deactivate FCM token on logout",
              "operation": "UpdateItem",
              "parameters": [
                { "name": "userId", "type": "string" },
                { "name": "deviceId", "type": "string" },
                { "name": "isActive", "type": "boolean" }
              ],
              "return_type": "single_entity"
            },
            {
              "pattern_id": 215,
              "name": "list_user_devices",
              "description": "List all registered devices for a user",
              "operation": "Query",
              "range_condition": "begins_with",
              "consistent_read": false,
              "parameters": [
                { "name": "userId", "type": "string" },
                { "name": "prefix", "type": "string" }
              ],
              "return_type": "entity_list"
            }
          ]
        }
      }
    }
  ]
}
