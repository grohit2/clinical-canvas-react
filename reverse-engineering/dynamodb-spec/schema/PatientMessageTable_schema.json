{
  "tables": [
    {
      "table_config": {
        "table_name": "PatientMessageTable",
        "partition_key": "PK",
        "sort_key": "SK"
      },
      "gsi_list": [
        { "name": "GSI1", "partition_key": "GSI1PK", "sort_key": "GSI1SK", "projection": "ALL" }
      ],
      "entities": {
        "PatientMessage": {
          "entity_type": "MSG",
          "pk_template": "PAT#{mrn}#ENC#{encounterNumber}",
          "sk_template": "MSG#{sentTime}##{messageId}",
          "gsi_mappings": [
            { "name": "GSI1", "pk_template": "PENDING#MSG#{senderLogin}", "sk_template": "TIME#{sentTime}" }
          ],
          "fields": [
            { "name": "mrn", "type": "string", "required": true },
            { "name": "encounterNumber", "type": "string", "required": true },
            { "name": "messageId", "type": "string", "required": true },
            { "name": "patientName", "type": "string", "required": false },
            { "name": "category", "type": "string", "required": true },
            { "name": "subCategory", "type": "string", "required": false },
            { "name": "contentType", "type": "string", "required": true },
            { "name": "content", "type": "string", "required": true },
            { "name": "senderLogin", "type": "string", "required": true },
            { "name": "senderName", "type": "string", "required": false },
            { "name": "sentTime", "type": "string", "required": true },
            { "name": "receivedTime", "type": "string", "required": false },
            { "name": "actionId", "type": "string", "required": false },
            { "name": "messageStatus", "type": "string", "required": true },
            { "name": "read", "type": "integer", "required": false },
            { "name": "msgStarred", "type": "boolean", "required": false },
            { "name": "msgDeleted", "type": "boolean", "required": false },
            { "name": "parentMessageId", "type": "string", "required": false },
            { "name": "action", "type": "string", "required": false },
            { "name": "context", "type": "string", "required": false }
          ],
          "access_patterns": [
            { "pattern_id": 801, "name": "list_messages", "description": "List messages for patient encounter", "operation": "Query", "range_condition": "begins_with", "consistent_read": false, "parameters": [{ "name": "pkValue", "type": "string" }, { "name": "prefix", "type": "string" }], "return_type": "entity_list" },
            { "pattern_id": 802, "name": "send_message", "description": "Send a clinical message", "operation": "PutItem", "parameters": [{ "name": "message", "type": "entity", "entity_type": "PatientMessage" }], "return_type": "single_entity" },
            { "pattern_id": 803, "name": "mark_read", "description": "Mark message as read", "operation": "UpdateItem", "parameters": [{ "name": "pkValue", "type": "string" }, { "name": "sk", "type": "string" }, { "name": "read", "type": "integer" }], "return_type": "single_entity" },
            { "pattern_id": 804, "name": "star_message", "description": "Star/unstar a message", "operation": "UpdateItem", "parameters": [{ "name": "pkValue", "type": "string" }, { "name": "sk", "type": "string" }, { "name": "msgStarred", "type": "boolean" }], "return_type": "single_entity" },
            { "pattern_id": 805, "name": "pending_messages", "description": "Get offline queued messages for sender", "operation": "Query", "index_name": "GSI1", "consistent_read": false, "parameters": [{ "name": "senderLogin", "type": "string" }], "return_type": "entity_list" }
          ]
        }
      }
    }
  ]
}
