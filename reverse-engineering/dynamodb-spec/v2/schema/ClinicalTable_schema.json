{
  "tables": [
    {
      "table_config": {
        "table_name": "ClinicalTable",
        "partition_key": "PK",
        "sort_key": "SK"
      },
      "gsi_list": [
        { "name": "GSI1", "partition_key": "GSI1PK", "sort_key": "GSI1SK", "projection": "ALL" },
        { "name": "GSI2", "partition_key": "GSI2PK", "sort_key": "GSI2SK", "projection": "ALL" },
        { "name": "GSI3", "partition_key": "GSI3PK", "sort_key": "GSI3SK", "projection": "KEYS_ONLY" }
      ],
      "entities": {
        "MedicationOrder": {
          "entity_type": "MED",
          "pk_template": "ENC#{encounterNumber}",
          "sk_template": "MED#{medicationId}",
          "gsi_mappings": [
            { "name": "GSI1", "pk_template": "PAT#{patientMrn}", "sk_template": "MED#STATUS#{status}#MED#{medicationId}" },
            { "name": "GSI3", "pk_template": "ENC#{encounterNumber}#STATUS#{status}", "sk_template": "DATE#{prescriptionDate}" }
          ],
          "fields": [
            { "name": "medicationId", "type": "string", "required": true },
            { "name": "encounterNumber", "type": "string", "required": true },
            { "name": "patientMrn", "type": "string", "required": true },
            { "name": "patientName", "type": "string", "required": true },
            { "name": "status", "type": "string", "required": true },
            { "name": "medication", "type": "object", "required": true },
            { "name": "daywiseDosage", "type": "object", "required": false },
            { "name": "drugFrequency", "type": "object", "required": false },
            { "name": "duration", "type": "integer", "required": false },
            { "name": "durationUnit", "type": "string", "required": false },
            { "name": "quantity", "type": "integer", "required": false },
            { "name": "route", "type": "string", "required": false },
            { "name": "foodInstruction", "type": "string", "required": false },
            { "name": "patientInstruction", "type": "string", "required": false },
            { "name": "prescriptionDate", "type": "string", "required": true },
            { "name": "isDischargeMedication", "type": "boolean", "required": false },
            { "name": "orderedBy", "type": "object", "required": false },
            { "name": "createdOn", "type": "string", "required": true }
          ],
          "access_patterns": [
            { "pattern_id": 1, "name": "list_meds", "description": "List medications for encounter", "operation": "Query", "range_condition": "begins_with", "consistent_read": false, "parameters": [{ "name": "encounterNumber", "type": "string" }, { "name": "prefix", "type": "string" }], "return_type": "entity_list" },
            { "pattern_id": 2, "name": "get_med", "description": "Get specific medication", "operation": "GetItem", "consistent_read": true, "parameters": [{ "name": "encounterNumber", "type": "string" }, { "name": "medicationId", "type": "string" }], "return_type": "single_entity" },
            { "pattern_id": 3, "name": "create_med", "description": "Create medication order", "operation": "PutItem", "parameters": [{ "name": "med", "type": "entity", "entity_type": "MedicationOrder" }], "return_type": "single_entity" },
            { "pattern_id": 4, "name": "patient_active_meds", "description": "Active meds by patient", "operation": "Query", "index_name": "GSI1", "range_condition": "begins_with", "consistent_read": false, "parameters": [{ "name": "patientMrn", "type": "string" }, { "name": "statusPrefix", "type": "string" }], "return_type": "entity_list" }
          ]
        },
        "LabResult": {
          "entity_type": "RESULT",
          "pk_template": "ENC#{encounterNumber}",
          "sk_template": "RESULT#{resultCode}##{resultDate}",
          "gsi_mappings": [
            { "name": "GSI1", "pk_template": "PAT#{patientMrn}", "sk_template": "RESULT#{resultDate}##{resultCode}" }
          ],
          "fields": [
            { "name": "encounterNumber", "type": "string", "required": true },
            { "name": "patientMrn", "type": "string", "required": true },
            { "name": "resultCode", "type": "string", "required": true },
            { "name": "resultName", "type": "string", "required": true },
            { "name": "value", "type": "string", "required": false },
            { "name": "resultType", "type": "string", "required": true },
            { "name": "unit", "type": "string", "required": false },
            { "name": "referenceRange", "type": "string", "required": false },
            { "name": "abnormalFlag", "type": "string", "required": false },
            { "name": "resultDate", "type": "string", "required": true },
            { "name": "parameters", "type": "array", "required": false, "item_type": "object" },
            { "name": "reports", "type": "array", "required": false, "item_type": "object" }
          ],
          "access_patterns": [
            { "pattern_id": 5, "name": "list_results", "description": "Lab results for encounter", "operation": "Query", "range_condition": "begins_with", "consistent_read": false, "parameters": [{ "name": "encounterNumber", "type": "string" }, { "name": "prefix", "type": "string" }], "return_type": "entity_list" },
            { "pattern_id": 6, "name": "store_result", "description": "Store lab result", "operation": "PutItem", "parameters": [{ "name": "result", "type": "entity", "entity_type": "LabResult" }], "return_type": "single_entity" },
            { "pattern_id": 7, "name": "patient_results", "description": "Cross-encounter patient results", "operation": "Query", "index_name": "GSI1", "range_condition": "begins_with", "consistent_read": false, "parameters": [{ "name": "patientMrn", "type": "string" }, { "name": "prefix", "type": "string" }], "return_type": "entity_list" }
          ]
        },
        "ProgressNote": {
          "entity_type": "PN",
          "pk_template": "ENC#{encounterNumber}",
          "sk_template": "DOC#PN#{documentNumber}",
          "gsi_mappings": [
            { "name": "GSI1", "pk_template": "PAT#{patientMrn}", "sk_template": "DOC#PN#{createdOn}##{documentNumber}" },
            { "name": "GSI2", "pk_template": "PENDING#ACK#{consultantLogin}", "sk_template": "DATE#{createdOn}" }
          ],
          "fields": [
            { "name": "encounterNumber", "type": "string", "required": true },
            { "name": "documentNumber", "type": "string", "required": true },
            { "name": "patientMrn", "type": "string", "required": true },
            { "name": "text", "type": "string", "required": true },
            { "name": "status", "type": "string", "required": true },
            { "name": "submittedBy", "type": "string", "required": false },
            { "name": "acknowledgedBy", "type": "object", "required": false },
            { "name": "createdOn", "type": "string", "required": true },
            { "name": "createdBy", "type": "object", "required": false },
            { "name": "consultantLogin", "type": "string", "required": false }
          ],
          "access_patterns": [
            { "pattern_id": 8, "name": "list_notes", "description": "Progress notes for encounter", "operation": "Query", "range_condition": "begins_with", "consistent_read": false, "parameters": [{ "name": "encounterNumber", "type": "string" }, { "name": "prefix", "type": "string" }], "return_type": "entity_list" },
            { "pattern_id": 9, "name": "create_note", "description": "Create progress note", "operation": "PutItem", "parameters": [{ "name": "note", "type": "entity", "entity_type": "ProgressNote" }], "return_type": "single_entity" },
            { "pattern_id": 10, "name": "pending_acks", "description": "Pending acknowledgments (sparse)", "operation": "Query", "index_name": "GSI2", "consistent_read": false, "parameters": [{ "name": "consultantLogin", "type": "string" }], "return_type": "entity_list" },
            { "pattern_id": 11, "name": "acknowledge", "description": "Acknowledge note and remove from GSI2", "operation": "UpdateItem", "parameters": [{ "name": "encounterNumber", "type": "string" }, { "name": "documentNumber", "type": "string" }, { "name": "status", "type": "string" }], "return_type": "single_entity" }
          ]
        },
        "VitalReading": {
          "entity_type": "VITAL",
          "pk_template": "ENC#{encounterNumber}",
          "sk_template": "VITAL#{recordDate}#{recordTime}",
          "gsi_mappings": [
            { "name": "GSI1", "pk_template": "PAT#{patientMrn}", "sk_template": "VITAL#{recordDate}##{recordTime}" }
          ],
          "fields": [
            { "name": "encounterNumber", "type": "string", "required": true },
            { "name": "patientMrn", "type": "string", "required": true },
            { "name": "recordDate", "type": "string", "required": true },
            { "name": "recordTime", "type": "string", "required": true },
            { "name": "systolicBP", "type": "integer", "required": false },
            { "name": "diastolicBP", "type": "integer", "required": false },
            { "name": "pulse", "type": "integer", "required": false },
            { "name": "temperature", "type": "decimal", "required": false },
            { "name": "spO2", "type": "decimal", "required": false },
            { "name": "respiratoryRate", "type": "integer", "required": false },
            { "name": "recordedBy", "type": "object", "required": false },
            { "name": "recordedAt", "type": "string", "required": true }
          ],
          "access_patterns": [
            { "pattern_id": 12, "name": "record_vitals", "description": "Record vitals", "operation": "PutItem", "parameters": [{ "name": "vital", "type": "entity", "entity_type": "VitalReading" }], "return_type": "single_entity" },
            { "pattern_id": 13, "name": "encounter_vitals", "description": "Vitals for encounter", "operation": "Query", "range_condition": "begins_with", "consistent_read": false, "parameters": [{ "name": "encounterNumber", "type": "string" }, { "name": "prefix", "type": "string" }], "return_type": "entity_list" },
            { "pattern_id": 14, "name": "patient_vitals", "description": "Cross-encounter vitals", "operation": "Query", "index_name": "GSI1", "range_condition": "begins_with", "consistent_read": false, "parameters": [{ "name": "patientMrn", "type": "string" }, { "name": "prefix", "type": "string" }], "return_type": "entity_list" }
          ]
        }
      }
    }
  ]
}
