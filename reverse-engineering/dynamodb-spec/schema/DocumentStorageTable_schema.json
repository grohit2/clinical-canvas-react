{
  "tables": [
    {
      "table_config": {
        "table_name": "DocumentStorageTable",
        "partition_key": "PK",
        "sort_key": "SK"
      },
      "gsi_list": [
        { "name": "GSI1", "partition_key": "GSI1PK", "sort_key": "GSI1SK", "projection": "KEYS_ONLY" }
      ],
      "entities": {
        "PatientDocument": {
          "entity_type": "DOC",
          "pk_template": "PAT#{patientId}",
          "sk_template": "DOC#{documentId}",
          "fields": [
            { "name": "patientId", "type": "string", "required": true },
            { "name": "documentId", "type": "string", "required": true },
            { "name": "documentType", "type": "string", "required": true },
            { "name": "fileName", "type": "string", "required": true },
            { "name": "fileUrl", "type": "string", "required": false },
            { "name": "mimeType", "type": "string", "required": true },
            { "name": "fileSize", "type": "integer", "required": false },
            { "name": "uploadedAt", "type": "string", "required": true },
            { "name": "uploadedBy", "type": "string", "required": true },
            { "name": "description", "type": "string", "required": false },
            { "name": "s3Key", "type": "string", "required": true },
            { "name": "s3Bucket", "type": "string", "required": true }
          ],
          "access_patterns": [
            { "pattern_id": 1301, "name": "list_documents", "description": "List patient documents", "operation": "Query", "range_condition": "begins_with", "consistent_read": false, "parameters": [{ "name": "patientId", "type": "string" }, { "name": "prefix", "type": "string" }], "return_type": "entity_list" },
            { "pattern_id": 1302, "name": "upload_document", "description": "Store document metadata", "operation": "PutItem", "parameters": [{ "name": "document", "type": "entity", "entity_type": "PatientDocument" }], "return_type": "single_entity" },
            { "pattern_id": 1303, "name": "get_document", "description": "Get document metadata", "operation": "GetItem", "consistent_read": true, "parameters": [{ "name": "patientId", "type": "string" }, { "name": "documentId", "type": "string" }], "return_type": "single_entity" }
          ]
        }
      }
    }
  ]
}
