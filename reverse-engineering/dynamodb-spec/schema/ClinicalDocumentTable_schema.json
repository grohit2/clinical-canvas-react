{
  "tables": [
    {
      "table_config": {
        "table_name": "ClinicalDocumentTable",
        "partition_key": "PK",
        "sort_key": "SK"
      },
      "gsi_list": [
        { "name": "GSI1", "partition_key": "GSI1PK", "sort_key": "GSI1SK", "projection": "ALL" },
        { "name": "GSI2", "partition_key": "GSI2PK", "sort_key": "GSI2SK", "projection": "ALL" }
      ],
      "entities": {
        "ProgressNote": {
          "entity_type": "PN",
          "pk_template": "ENC#{encounterNumber}",
          "sk_template": "DOC#PN#{documentNumber}",
          "gsi_mappings": [
            { "name": "GSI1", "pk_template": "PENDING#ACK#{consultantLogin}", "sk_template": "DATE#{createdOn}" },
            { "name": "GSI2", "pk_template": "PAT#{patientMrn}", "sk_template": "TYPE#PN#DATE#{createdOn}" }
          ],
          "fields": [
            { "name": "encounterNumber", "type": "string", "required": true },
            { "name": "documentNumber", "type": "string", "required": true },
            { "name": "patientMrn", "type": "string", "required": true },
            { "name": "patientName", "type": "string", "required": false },
            { "name": "text", "type": "string", "required": true },
            { "name": "sourceDepartment", "type": "object", "required": false },
            { "name": "status", "type": "string", "required": true },
            { "name": "submittedBy", "type": "string", "required": false },
            { "name": "submittedDate", "type": "string", "required": false },
            { "name": "acknowledgedBy", "type": "object", "required": false },
            { "name": "pad", "type": "integer", "required": false },
            { "name": "createdOn", "type": "string", "required": true },
            { "name": "createdBy", "type": "object", "required": false },
            { "name": "consultantLogin", "type": "string", "required": false },
            { "name": "vitals", "type": "array", "required": false, "item_type": "object" },
            { "name": "medications", "type": "array", "required": false, "item_type": "object" },
            { "name": "investigations", "type": "array", "required": false, "item_type": "object" }
          ],
          "access_patterns": [
            { "pattern_id": 1501, "name": "list_progress_notes", "description": "List progress notes for encounter", "operation": "Query", "range_condition": "begins_with", "consistent_read": false, "parameters": [{ "name": "encounterNumber", "type": "string" }, { "name": "prefix", "type": "string" }], "return_type": "entity_list" },
            { "pattern_id": 1502, "name": "create_progress_note", "description": "Create progress note", "operation": "PutItem", "parameters": [{ "name": "note", "type": "entity", "entity_type": "ProgressNote" }], "return_type": "single_entity" },
            { "pattern_id": 1503, "name": "get_progress_note", "description": "Get specific progress note", "operation": "GetItem", "consistent_read": true, "parameters": [{ "name": "encounterNumber", "type": "string" }, { "name": "documentNumber", "type": "string" }], "return_type": "single_entity" },
            { "pattern_id": 1504, "name": "pending_acknowledgments", "description": "Progress notes pending ack (sparse GSI)", "operation": "Query", "index_name": "GSI1", "consistent_read": false, "parameters": [{ "name": "consultantLogin", "type": "string" }], "return_type": "entity_list" },
            { "pattern_id": 1505, "name": "acknowledge_note", "description": "Acknowledge progress note and remove from pending GSI", "operation": "UpdateItem", "parameters": [{ "name": "encounterNumber", "type": "string" }, { "name": "documentNumber", "type": "string" }, { "name": "status", "type": "string" }], "return_type": "single_entity" },
            { "pattern_id": 1506, "name": "patient_notes", "description": "All notes for patient across encounters", "operation": "Query", "index_name": "GSI2", "range_condition": "begins_with", "consistent_read": false, "parameters": [{ "name": "patientMrn", "type": "string" }, { "name": "typePrefix", "type": "string" }], "return_type": "entity_list" }
          ]
        },
        "DischargeSummary": {
          "entity_type": "DS",
          "pk_template": "ENC#{encounterNumber}",
          "sk_template": "DOC#DS#{documentNumber}",
          "gsi_mappings": [
            { "name": "GSI1", "pk_template": "PENDING#SIGNOFF#{unitCode}", "sk_template": "DATE#{createdOn}" }
          ],
          "fields": [
            { "name": "encounterNumber", "type": "string", "required": true },
            { "name": "documentNumber", "type": "string", "required": true },
            { "name": "patientMrn", "type": "string", "required": true },
            { "name": "status", "type": "string", "required": true },
            { "name": "admissionNumber", "type": "string", "required": false },
            { "name": "patientDetails", "type": "object", "required": false },
            { "name": "admissionReason", "type": "string", "required": false },
            { "name": "chiefComplaint", "type": "string", "required": false },
            { "name": "medicalHistory", "type": "string", "required": false },
            { "name": "finalDiagnosis", "type": "string", "required": false },
            { "name": "medicationAtDischarge", "type": "string", "required": false },
            { "name": "dischargeAdvice", "type": "string", "required": false },
            { "name": "followUp", "type": "string", "required": false },
            { "name": "comments", "type": "array", "required": false, "item_type": "object" },
            { "name": "amended", "type": "boolean", "required": false },
            { "name": "createdOn", "type": "string", "required": true },
            { "name": "createdBy", "type": "object", "required": false },
            { "name": "unitCode", "type": "string", "required": false }
          ],
          "access_patterns": [
            { "pattern_id": 1507, "name": "get_discharge_summary", "description": "Get discharge summary", "operation": "GetItem", "consistent_read": true, "parameters": [{ "name": "encounterNumber", "type": "string" }, { "name": "documentNumber", "type": "string" }], "return_type": "single_entity" },
            { "pattern_id": 1508, "name": "create_discharge_summary", "description": "Create discharge summary", "operation": "PutItem", "parameters": [{ "name": "ds", "type": "entity", "entity_type": "DischargeSummary" }], "return_type": "single_entity" },
            { "pattern_id": 1509, "name": "pending_signoff", "description": "DS pending sign-off (sparse GSI)", "operation": "Query", "index_name": "GSI1", "consistent_read": false, "parameters": [{ "name": "unitCode", "type": "string" }], "return_type": "entity_list" }
          ]
        },
        "Checklist": {
          "entity_type": "CK",
          "pk_template": "ENC#{encounterNumber}",
          "sk_template": "DOC#CK#{checklistNumber}",
          "fields": [
            { "name": "encounterNumber", "type": "string", "required": true },
            { "name": "checklistNumber", "type": "string", "required": true },
            { "name": "name", "type": "string", "required": true },
            { "name": "status", "type": "string", "required": true },
            { "name": "responseType", "type": "object", "required": false },
            { "name": "sequentialAnswering", "type": "boolean", "required": false },
            { "name": "witness", "type": "string", "required": false },
            { "name": "questions", "type": "array", "required": false, "item_type": "object" },
            { "name": "remarks", "type": "string", "required": false },
            { "name": "rejectReason", "type": "string", "required": false },
            { "name": "createdBy", "type": "object", "required": false },
            { "name": "createdOn", "type": "string", "required": true }
          ],
          "access_patterns": [
            { "pattern_id": 1510, "name": "list_checklists", "description": "List checklists for encounter", "operation": "Query", "range_condition": "begins_with", "consistent_read": false, "parameters": [{ "name": "encounterNumber", "type": "string" }, { "name": "prefix", "type": "string" }], "return_type": "entity_list" },
            { "pattern_id": 1511, "name": "save_checklist", "description": "Create/update checklist", "operation": "PutItem", "parameters": [{ "name": "checklist", "type": "entity", "entity_type": "Checklist" }], "return_type": "single_entity" }
          ]
        }
      }
    }
  ]
}
