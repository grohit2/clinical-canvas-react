{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/ralph-user-prompt.mjs\"",
            "statusMessage": "loading Ralph context"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/guard-pre-tool.mjs\"",
            "statusMessage": "checking command guardrails"
          }
        ]
      }
    ]
  }
}
