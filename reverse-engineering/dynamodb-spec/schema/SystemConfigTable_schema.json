{
  "tables": [
    {
      "table_config": {
        "table_name": "SystemConfigTable",
        "partition_key": "PK",
        "sort_key": "SK"
      },
      "entities": {
        "AppConfig": {
          "entity_type": "CONFIG",
          "pk_template": "CONFIG#APP",
          "sk_template": "LATEST",
          "fields": [
            { "name": "appVersion", "type": "string", "required": true },
            { "name": "forceUpdate", "type": "boolean", "required": true },
            { "name": "maintenanceMode", "type": "boolean", "required": true },
            { "name": "maintenanceMessage", "type": "string", "required": false },
            { "name": "features", "type": "object", "required": false },
            { "name": "apiBaseUrl", "type": "string", "required": true },
            { "name": "acsEndpoint", "type": "string", "required": false },
            { "name": "chatEnabled", "type": "boolean", "required": false },
            { "name": "campEnabled", "type": "boolean", "required": false },
            { "name": "lastUpdated", "type": "string", "required": true }
          ],
          "access_patterns": [
            { "pattern_id": 1401, "name": "get_app_config", "description": "Get current app configuration", "operation": "GetItem", "consistent_read": false, "parameters": [], "return_type": "single_entity" },
            { "pattern_id": 1402, "name": "update_app_config", "description": "Update app configuration", "operation": "PutItem", "parameters": [{ "name": "config", "type": "entity", "entity_type": "AppConfig" }], "return_type": "single_entity" }
          ]
        },
        "GeographyRecord": {
          "entity_type": "GEO",
          "pk_template": "GEO#{geoType}",
          "sk_template": "{geoCode}",
          "fields": [
            { "name": "geoType", "type": "string", "required": true },
            { "name": "geoCode", "type": "string", "required": true },
            { "name": "name", "type": "string", "required": true },
            { "name": "parentCode", "type": "string", "required": false },
            { "name": "isActive", "type": "boolean", "required": true }
          ],
          "access_patterns": [
            { "pattern_id": 1403, "name": "lookup_geo", "description": "Lookup geography record", "operation": "GetItem", "consistent_read": false, "parameters": [{ "name": "geoType", "type": "string" }, { "name": "geoCode", "type": "string" }], "return_type": "single_entity" },
            { "pattern_id": 1404, "name": "list_geo_children", "description": "List children of a geography level", "operation": "Query", "range_condition": "begins_with", "consistent_read": false, "parameters": [{ "name": "geoType", "type": "string" }, { "name": "parentPrefix", "type": "string" }], "return_type": "entity_list" }
          ]
        },
        "AuditEvent": {
          "entity_type": "AUDIT",
          "pk_template": "AUDIT#{eventDate}",
          "sk_template": "{eventTimestamp}##{eventId}",
          "fields": [
            { "name": "eventDate", "type": "string", "required": true },
            { "name": "eventTimestamp", "type": "string", "required": true },
            { "name": "eventId", "type": "string", "required": true },
            { "name": "logLevel", "type": "string", "required": false },
            { "name": "eventCategory", "type": "string", "required": false },
            { "name": "eventAction", "type": "string", "required": false },
            { "name": "requestUrl", "type": "string", "required": false },
            { "name": "requestMethod", "type": "string", "required": false },
            { "name": "responseStatus", "type": "integer", "required": false },
            { "name": "errorMessage", "type": "string", "required": false },
            { "name": "serviceName", "type": "string", "required": false },
            { "name": "ttl", "type": "integer", "required": false }
          ],
          "access_patterns": [
            { "pattern_id": 1405, "name": "store_audit_event", "description": "Store an audit event", "operation": "PutItem", "parameters": [{ "name": "event", "type": "entity", "entity_type": "AuditEvent" }], "return_type": "single_entity" }
          ]
        }
      }
    }
  ]
}
