{
  "tables": [
    {
      "table_config": {
        "table_name": "PatientTable",
        "partition_key": "PK",
        "sort_key": "SK"
      },
      "gsi_list": [
        {
          "name": "GSI1",
          "partition_key": "GSI1PK",
          "sort_key": "GSI1SK",
          "projection": "ALL"
        },
        {
          "name": "GSI2",
          "partition_key": "GSI2PK",
          "sort_key": "GSI2SK",
          "projection": "ALL"
        },
        {
          "name": "GSI3",
          "partition_key": "GSI3PK",
          "sort_key": "GSI3SK",
          "projection": "KEYS_ONLY"
        }
      ],
      "entities": {
        "PatientProfile": {
          "entity_type": "PROFILE",
          "pk_template": "PAT#{patientId}",
          "sk_template": "PROFILE",
          "gsi_mappings": [
            {
              "name": "GSI1",
              "pk_template": "MRN#{mrn}",
              "sk_template": "PAT#{patientId}"
            },
            {
              "name": "GSI2",
              "pk_template": "UHID#{uhid}",
              "sk_template": "PAT#{patientId}"
            },
            {
              "name": "GSI3",
              "pk_template": "PHONE#{mobileNumber}",
              "sk_template": "PAT#{patientId}"
            }
          ],
          "fields": [
            { "name": "patientId", "type": "string", "required": true },
            { "name": "mrn", "type": "string", "required": false },
            { "name": "uhid", "type": "string", "required": false },
            { "name": "firstName", "type": "string", "required": true },
            { "name": "lastName", "type": "string", "required": false },
            { "name": "fullName", "type": "string", "required": true },
            { "name": "dateOfBirth", "type": "string", "required": true },
            { "name": "age", "type": "object", "required": false },
            { "name": "gender", "type": "string", "required": true },
            { "name": "mobileNumber", "type": "string", "required": true },
            { "name": "email", "type": "string", "required": false },
            { "name": "address", "type": "object", "required": false },
            { "name": "aadhaarNumber", "type": "string", "required": false },
            { "name": "patientType", "type": "string", "required": false },
            { "name": "registrationDate", "type": "string", "required": true },
            { "name": "registrationSource", "type": "string", "required": false },
            { "name": "status", "type": "string", "required": true },
            { "name": "unitCode", "type": "string", "required": true },
            { "name": "organizationId", "type": "string", "required": true },
            { "name": "photo", "type": "string", "required": false },
            { "name": "bloodGroup", "type": "string", "required": false },
            { "name": "maritalStatus", "type": "string", "required": false },
            { "name": "nationality", "type": "string", "required": false },
            { "name": "emergencyContactName", "type": "string", "required": false },
            { "name": "emergencyContactNumber", "type": "string", "required": false },
            { "name": "insuranceDetails", "type": "object", "required": false },
            { "name": "weight", "type": "string", "required": false },
            { "name": "height", "type": "string", "required": false },
            { "name": "allergiesSnapshot", "type": "array", "required": false, "item_type": "string" },
            { "name": "comorbidities", "type": "string", "required": false },
            { "name": "createdAt", "type": "string", "required": true },
            { "name": "updatedAt", "type": "string", "required": false }
          ],
          "access_patterns": [
            {
              "pattern_id": 101,
              "name": "get_patient_by_id",
              "description": "Get patient profile by patient ID",
              "operation": "GetItem",
              "consistent_read": true,
              "parameters": [
                { "name": "patientId", "type": "string" }
              ],
              "return_type": "single_entity"
            },
            {
              "pattern_id": 102,
              "name": "get_patient_by_mrn",
              "description": "Lookup patient by Medical Record Number",
              "operation": "Query",
              "index_name": "GSI1",
              "consistent_read": false,
              "parameters": [
                { "name": "mrn", "type": "string" }
              ],
              "return_type": "entity_list"
            },
            {
              "pattern_id": 103,
              "name": "get_patient_by_uhid",
              "description": "Lookup patient by Universal Health ID",
              "operation": "Query",
              "index_name": "GSI2",
              "consistent_read": false,
              "parameters": [
                { "name": "uhid", "type": "string" }
              ],
              "return_type": "entity_list"
            },
            {
              "pattern_id": 104,
              "name": "search_patient_by_phone",
              "description": "Search patients by mobile number",
              "operation": "Query",
              "index_name": "GSI3",
              "consistent_read": false,
              "parameters": [
                { "name": "mobileNumber", "type": "string" }
              ],
              "return_type": "entity_list"
            },
            {
              "pattern_id": 105,
              "name": "create_patient",
              "description": "Register a new patient",
              "operation": "PutItem",
              "parameters": [
                { "name": "patient", "type": "entity", "entity_type": "PatientProfile" }
              ],
              "return_type": "single_entity"
            },
            {
              "pattern_id": 106,
              "name": "update_patient_demographics",
              "description": "Update patient demographics",
              "operation": "UpdateItem",
              "parameters": [
                { "name": "patientId", "type": "string" },
                { "name": "fullName", "type": "string" },
                { "name": "mobileNumber", "type": "string" },
                { "name": "address", "type": "object" }
              ],
              "return_type": "single_entity"
            }
          ]
        },
        "AadhaarVerification": {
          "entity_type": "AADHAAR",
          "pk_template": "PAT#{patientId}",
          "sk_template": "AADHAAR",
          "fields": [
            { "name": "patientId", "type": "string", "required": true },
            { "name": "aadhaarNumber", "type": "string", "required": true },
            { "name": "nameOnAadhaar", "type": "string", "required": true },
            { "name": "dobOnAadhaar", "type": "string", "required": false },
            { "name": "genderOnAadhaar", "type": "string", "required": false },
            { "name": "addressOnAadhaar", "type": "string", "required": false },
            { "name": "photoFromAadhaar", "type": "string", "required": false },
            { "name": "verified", "type": "boolean", "required": true },
            { "name": "verificationTimestamp", "type": "string", "required": true },
            { "name": "verificationSource", "type": "string", "required": false }
          ],
          "access_patterns": [
            {
              "pattern_id": 107,
              "name": "store_aadhaar_verification",
              "description": "Store Aadhaar KYC verification result",
              "operation": "PutItem",
              "parameters": [
                { "name": "aadhaar", "type": "entity", "entity_type": "AadhaarVerification" }
              ],
              "return_type": "single_entity"
            },
            {
              "pattern_id": 108,
              "name": "get_aadhaar_verification",
              "description": "Get Aadhaar verification for patient",
              "operation": "GetItem",
              "consistent_read": false,
              "parameters": [
                { "name": "patientId", "type": "string" }
              ],
              "return_type": "single_entity"
            }
          ]
        },
        "PatientLabel": {
          "entity_type": "LABEL",
          "pk_template": "PAT#{patientId}",
          "sk_template": "LABEL#{labelId}",
          "fields": [
            { "name": "patientId", "type": "string", "required": true },
            { "name": "labelId", "type": "string", "required": true },
            { "name": "labelName", "type": "string", "required": true },
            { "name": "labelColor", "type": "string", "required": false },
            { "name": "createdBy", "type": "string", "required": false },
            { "name": "createdAt", "type": "string", "required": false }
          ],
          "access_patterns": [
            {
              "pattern_id": 109,
              "name": "add_patient_label",
              "description": "Add a label to a patient",
              "operation": "PutItem",
              "parameters": [
                { "name": "label", "type": "entity", "entity_type": "PatientLabel" }
              ],
              "return_type": "single_entity"
            },
            {
              "pattern_id": 110,
              "name": "remove_patient_label",
              "description": "Remove a label from a patient",
              "operation": "DeleteItem",
              "parameters": [
                { "name": "patientId", "type": "string" },
                { "name": "labelId", "type": "string" }
              ],
              "return_type": "success_flag"
            },
            {
              "pattern_id": 111,
              "name": "list_patient_labels",
              "description": "List all labels for a patient",
              "operation": "Query",
              "range_condition": "begins_with",
              "consistent_read": false,
              "parameters": [
                { "name": "patientId", "type": "string" },
                { "name": "prefix", "type": "string" }
              ],
              "return_type": "entity_list"
            }
          ]
        },
        "EmergencyContact": {
          "entity_type": "CONTACT",
          "pk_template": "PAT#{patientId}",
          "sk_template": "CONTACT#{contactId}",
          "fields": [
            { "name": "patientId", "type": "string", "required": true },
            { "name": "contactId", "type": "string", "required": true },
            { "name": "contactName", "type": "string", "required": true },
            { "name": "contactNumber", "type": "string", "required": true },
            { "name": "relationship", "type": "string", "required": false },
            { "name": "isPrimary", "type": "boolean", "required": false }
          ],
          "access_patterns": [
            {
              "pattern_id": 112,
              "name": "add_emergency_contact",
              "description": "Add an emergency contact for patient",
              "operation": "PutItem",
              "parameters": [
                { "name": "contact", "type": "entity", "entity_type": "EmergencyContact" }
              ],
              "return_type": "single_entity"
            },
            {
              "pattern_id": 113,
              "name": "list_emergency_contacts",
              "description": "List all emergency contacts for patient",
              "operation": "Query",
              "range_condition": "begins_with",
              "consistent_read": false,
              "parameters": [
                { "name": "patientId", "type": "string" },
                { "name": "prefix", "type": "string" }
              ],
              "return_type": "entity_list"
            }
          ]
        }
      }
    }
  ]
}
